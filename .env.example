# Copy to .env for docker compose. No secrets belong here: the client has none, and anything given to Vite as
# VITE_* would be built into the JavaScript every visitor downloads.

# Where the container's nginx sends /api and /hubs (read when the container starts).
# Locally, the API's "https" profile on the host:
API_UPSTREAM=https://host.docker.internal:7187

# Development only (npm run dev): where Vite's dev server proxies the API.
# HOURLINE_API=https://localhost:7187
