# ID InDetails client. Rendered at start-up by the nginx image, which replaces ${API_UPSTREAM} (and only the
# variables that are set) from the environment. TLS ends in front of this container; it serves plain HTTP.

# The scheme the visitor used, as the TLS proxy in front reports it.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# No query strings and no referrer: the live connection sends the access token as ?access_token=, and sign-up
# and reset links carry their token in the page's own query string.
map $request_uri $request_path {
    ~^(?<path>[^?]*) $path;
}
log_format no_query '$remote_addr [$time_local] "$request_method $request_path $server_protocol" $status $body_bytes_sent '
                    '$request_time "$http_user_agent"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    absolute_redirect off;
    access_log /dev/stdout no_query;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # The API. Requests are small JSON (the API refuses more than 1 MB too); only uploads are bigger, below.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        client_max_body_size 1m;
        # API answers are someone's own data: never compressed here or kept
        gzip off;
    }

    # Uploads: up to 100 MB (FileRules.MaxVideoBytes) plus the form around them, streamed to the API.
    location = /api/files {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        client_max_body_size 101m;
        proxy_request_buffering off;
        gzip off;
    }

    # The live connection (SignalR over WebSockets), open for as long as the page is.
    location /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        # its errors would quote the URL, token and all
        error_log /dev/stderr crit;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Content-hashed files: a new build has new names, so they never change.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The app's entry: always checked again, so a deploy shows at once.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Other files of the build (the favicon), and every app route, which the app draws itself.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri /index.html;
    }
}
